# This game's values for the shared scripts in sdk/scripts (sdk/scripts/common.sh lists each and its default)
GAME_XBE=default.xbe     # the disc's launcher and movie player; bond_eng.xbe (the game) and DRIVING.XBE are its own targets
GAME_LOG=auf             # GameInfo::log
GAME_TARGET=AgentUnderFire # the add_xbe_image target in CMakeLists.txt
GHIDRA_PROJECT=auf
SMOKE_PAD=scripts/pad/start.txt  # the movies; a START passes each until default.xbe relaunches into bond_eng.xbe
SMOKE_MENU="60 300"      # no draws while a movie plays
SMOKE_SECS=45
SMOKE_NEXT_GEN=generated/bond  # then bond_eng.xbe on that disk and launch data
SMOKE_NEXT_NAME=bond
SMOKE_NEXT_PAD=scripts/pad/explore.txt  # title, menus, the first mission
SMOKE_NEXT_SECS=90
SOAK_PAD=
